# Copy to .dev.vars for local development. Never commit real deployment secrets.
# Used to authorize the founder editor at /admin
ADMIN_USER_IDS=local_seedy
ADMIN_EMAILS=
ADMIN_PASSWORD=quazar_admin_secret
SITE_URL=http://127.0.0.1:5173

# Render / Production Deployment:
# 1. In Render dashboard -> Environment Variables:
#    - NODE_VERSION = 22.14.0
#    - ADMIN_USER_IDS = local_seedy
#    - ADMIN_PASSWORD = <your_chosen_secret_password>
#    - SITE_URL = https://<your-service>.onrender.com
# 2. Go to /admin and log in with your chosen ADMIN_PASSWORD.
