# Copy to .dev.vars for local development. Never commit real deployment secrets.
# The Sites starter simulates this identity only on loopback during npm run dev.
ADMIN_USER_IDS=local_seedy
ADMIN_EMAILS=
SITE_URL=http://127.0.0.1:5173

# Production: omit local_seedy. Set ADMIN_EMAILS to the two founders' ChatGPT
# account emails in Sites runtime settings. Stable Site user IDs can later be
# placed in ADMIN_USER_IDS. Set SITE_URL to the real HTTPS website origin.
